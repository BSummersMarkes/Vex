<Window x:Class="Vex.LitePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vex" Width="360" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" FontFamily="Segoe UI">
    <Border x:Name="Frame" Background="#F2151826" BorderBrush="#4A5A86" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="Header" Background="Transparent" Margin="0,0,0,8">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                        Background="Transparent" Foreground="#9AA3BF" BorderThickness="0" Cursor="Hand" ToolTip="Close (Esc)"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Vex" Foreground="#E8EAF2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="RemindTab" Content="Reminders" Margin="12,0,0,0" Padding="4,2" FontSize="12"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                    <!-- Nudges that went unanswered, with a count badge (Services/Pending.cs) -->
                    <Button x:Name="PendingTab" Padding="4,2" FontSize="12" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Things I asked that you didn't answer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending" VerticalAlignment="Center"/>
                            <Border x:Name="Badge" Margin="4,0,0,0" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="BadgeText" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Reminders: add one, see what's coming, and a few "right now" buttons -->
            <StackPanel x:Name="RemindPage" Grid.Row="1">
                <TextBlock x:Name="AddTitle" Text="Remind me" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="When" Padding="6,5" FontSize="13" Margin="0,0,6,0" ToolTip="When"/>
                        <TextBlock x:Name="WhenHint" Text="when" Margin="9,6,0,0" FontSize="13" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="What" Padding="6,5" FontSize="13" ToolTip="What to remind you about"/>
                        <TextBlock x:Name="WhatHint" Text="what" Margin="9,6,0,0" FontSize="13" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="AddBtn" Grid.Column="2" Content="Add" Margin="6,0,0,0" Padding="12,4" BorderThickness="0" Cursor="Hand"/>
                </Grid>
                <TextBlock x:Name="Help" FontSize="11" TextWrapping="Wrap" Margin="2,5,0,0"
                           Text="20m · 1h30m · 14:30 · 9am · tomorrow 9:00 · fri 16:00&#x0a;Repeating: daily 10:00 · weekdays 14:00 · mon,thu 9:30"/>

                <TextBlock x:Name="UpcomingTitle" Text="Coming up" FontSize="12" FontWeight="SemiBold" Margin="2,12,0,2"/>
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Upcoming"/>
                </ScrollViewer>

                <TextBlock x:Name="NowTitle" Text="Right now" FontSize="12" FontWeight="SemiBold" Margin="2,12,0,2"/>
                <WrapPanel x:Name="NowButtons"/>
            </StackPanel>

            <ScrollViewer x:Name="PendingPage" Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel x:Name="PendingList"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
