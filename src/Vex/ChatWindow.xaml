<Window x:Class="Vex.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vex" Width="360" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" FontFamily="Segoe UI">
    <Border x:Name="Frame" Background="#F2151826" BorderBrush="#4A5A86" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="Header" Background="Transparent" Margin="0,0,0,8">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                        Background="Transparent" Foreground="#9AA3BF" BorderThickness="0" Cursor="Hand"
                        ToolTip="Close (Esc)"/>
                <!-- Copy the whole chat: as text (for pasting into email/Teams), or as a picture -->
                <Button x:Name="CopyImageBtn" DockPanel.Dock="Right" Content="&#xE722;" FontFamily="Segoe MDL2 Assets"
                        Width="26" Height="26" Background="Transparent" Foreground="#9AA3BF" BorderThickness="0"
                        Cursor="Hand" ToolTip="Copy the chat as a picture"/>
                <Button x:Name="CopyTextBtn" DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                        Width="26" Height="26" Background="Transparent" Foreground="#9AA3BF" BorderThickness="0"
                        Cursor="Hand" ToolTip="Copy the chat as text (Ctrl+Shift+C)"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Vex" Foreground="#E8EAF2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- Chat / Pending: nudges and cards that went unanswered, with a count badge (Services/Pending.cs) -->
                    <Button x:Name="ChatTab" Content="Chat" Margin="12,0,0,0" Padding="4,2" FontSize="12"
                            Background="Transparent" Foreground="#E8EAF2" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                    <Button x:Name="PendingTab" Padding="4,2" FontSize="12" Background="Transparent" Foreground="#9AA3BF"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Things I asked that you didn't answer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending" VerticalAlignment="Center"/>
                            <Border x:Name="Badge" Margin="4,0,0,0" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                                    Background="#82292F" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="BadgeText" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Messages scroll inside the panel and wrap to its width; never sideways -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Messages"/>
            </ScrollViewer>
            <ScrollViewer x:Name="PendingScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel x:Name="PendingList"/>
            </ScrollViewer>
            <!-- Shown when something new arrives while scrolled up reading older messages -->
            <Button x:Name="NewBelow" Grid.Row="1" Content="New ↓" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,18,6" Padding="8,2" FontSize="11" BorderThickness="0" Cursor="Hand"
                    Background="#3A4568" Foreground="#E8EAF2" Visibility="Collapsed" ToolTip="Jump to the newest message"/>

            <TextBlock x:Name="Status" Grid.Row="2" Foreground="#8790AD" FontSize="11" FontStyle="Italic"
                       Margin="2,6,0,0" Visibility="Collapsed" Text="Vex is thinking…"/>

            <!-- Pictures pasted into the box (Ctrl+V), sent with the next message -->
            <WrapPanel x:Name="Attachments" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBox x:Name="Input" Grid.Row="4" Margin="0,8,0,0" MinHeight="34" MaxHeight="110"
                     Padding="8,6" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                     Background="#232842" Foreground="#E8EAF2" CaretBrush="#E8EAF2" BorderBrush="#3A4568"
                     FontSize="13"/>
        </Grid>
    </Border>
</Window>
