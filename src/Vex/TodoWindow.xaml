<Window x:Class="Vex.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To-do list" Width="300" Height="360" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" FontFamily="Segoe UI">
    <Border x:Name="Frame" Background="#F2151826" BorderBrush="#4A5A86" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="Header" Background="Transparent" Margin="0,0,0,8">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                        Background="Transparent" Foreground="#9AA3BF" BorderThickness="0" Cursor="Hand"
                        ToolTip="Close (Esc)"/>
                <TextBlock x:Name="TitleText" Text="To-do today" Foreground="#E8EAF2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Today's journal checkboxes, in the order they're written -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>

            <TextBlock x:Name="Status" Grid.Row="2" Foreground="#8790AD" FontSize="11" FontStyle="Italic"
                       Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBox x:Name="Input" Grid.Row="3" Margin="0,8,0,0" Padding="6,4" FontSize="13"
                     Background="#232842" Foreground="#E8EAF2" BorderBrush="#3A4568" CaretBrush="#E8EAF2"
                     ToolTip="Type a to-do and press Enter to add it to today's journal"/>
        </Grid>
    </Border>
</Window>
