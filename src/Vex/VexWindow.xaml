<Window x:Class="Vex.VexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vex" Width="260" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True">
    <!--
        Matte fabric style, from the design handoff (Downloads\Vex\HANDOFF.md, vex-fabric.svg).
        Coordinates match the SVG's 120 x 150 viewBox. Fabric grain comes from the "Weave" brush made in code.
        Fully transparent pixels let clicks through to whatever is underneath.
    -->
    <Window.Resources>
        <Geometry x:Key="BodyShape">M 40,74 C 35,96 32,116 30,135 Q 60,141 90,135 C 88,116 85,96 80,74 Z</Geometry>
        <Geometry x:Key="HoodShape">M 30,55 C 30,33 43,21 60,21 C 77,21 90,33 90,55 C 90,72 78,81 60,81 C 42,81 30,72 30,55 Z</Geometry>
        <RadialGradientBrush x:Key="Glove" Center="0.38,0.32" GradientOrigin="0.38,0.32" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Offset="0" Color="#F4F2EE"/><GradientStop Offset="0.65" Color="#E0DDD7"/><GradientStop Offset="1" Color="#B3AFA8"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Boot" Center="0.4,0.3" GradientOrigin="0.4,0.3" RadiusX="0.95" RadiusY="0.95">
            <GradientStop Offset="0" Color="#6E5244"/><GradientStop Offset="1" Color="#2E2018"/>
        </RadialGradientBrush>
        <BlurEffect x:Key="Crease" Radius="3"/>
        <BlurEffect x:Key="SoftShadow" Radius="6.5"/>
    </Window.Resources>

    <Canvas Width="260" Height="260">

        <!-- Speech bubble. Moved into its own little window at startup (see BubbleWindow) so it can sit
             wholly on one monitor and move in step with Vex. -->
        <Grid x:Name="BubbleHolder">
            <Border x:Name="Bubble" Visibility="Collapsed"
                    Background="#F01C2030" BorderBrush="#8E2F36" BorderThickness="1.5" CornerRadius="10"
                    Padding="10,6" MaxWidth="236" IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock x:Name="BubbleText" Foreground="#E8EAF2" FontSize="13" TextWrapping="Wrap"
                               FontFamily="Segoe UI"/>
                    <StackPanel x:Name="BubbleButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Zzz" Canvas.Left="158" Canvas.Top="122" Text="z Z" FontSize="16" FontWeight="Bold"
                   Foreground="#E0B8BC" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- The character. 120 x 150, centred on x=60, feet on the bottom edge of the window. -->
        <Canvas x:Name="Rig" Canvas.Left="70" Canvas.Top="110" Width="120" Height="150"
                RenderTransformOrigin="0.5,1" Cursor="Hand">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Squash"/>
                    <ScaleTransform x:Name="Facing"/>
                    <RotateTransform x:Name="Lean"/>
                    <TranslateTransform x:Name="Bob"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Ground shadow (faded out while he's climbing, VexClimb.cs) -->
            <Ellipse x:Name="Shadow" Canvas.Left="30" Canvas.Top="145.3" Width="60" Height="6.4" Fill="Black" Opacity="0.5"
                     Effect="{StaticResource SoftShadow}" IsHitTestVisible="False"/>

            <Canvas x:Name="Upper">
                <Canvas.RenderTransform><TranslateTransform x:Name="Breath"/></Canvas.RenderTransform>

                <!-- ── Torso ── -->
                <Path Data="{StaticResource BodyShape}">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#4E171C"/><GradientStop Offset="0.3" Color="#82292F"/>
                            <GradientStop Offset="0.6" Color="#76242A"/><GradientStop Offset="1" Color="#4A161A"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="{StaticResource BodyShape}" Fill="{DynamicResource Weave}" Opacity="0.75" IsHitTestVisible="False"/>
                <Canvas Clip="{StaticResource BodyShape}" IsHitTestVisible="False">
                    <Ellipse Canvas.Left="34" Canvas.Top="73" Width="52" Height="14" Fill="Black" Opacity="0.42" Effect="{StaticResource SoftShadow}"/>
                    <Canvas Effect="{StaticResource Crease}">
                        <Path Stroke="#47000000" StrokeThickness="1.4" Data="M 44,82 Q 38,94 33,106 M 76,82 Q 82,94 87,103"/>
                        <Path Stroke="#40A84850" StrokeThickness="1" Data="M 46,84 Q 41,95 36,107"/>
                        <Path Stroke="#33000000" StrokeThickness="1.8" Data="M 47,86 C 46,100 45,114 46,130 M 73,86 C 74,100 75,114 74,130"/>
                    </Canvas>
                    <!-- Ribbed hem -->
                    <Path Fill="#4E171B" Data="M 29,129 Q 60,134.5 91,129 L 92,142 Q 60,147 28,142 Z"/>
                    <Path Stroke="#CC38100F" StrokeThickness="0.6"
                          Data="M 36,131 L 35.6,139 M 42,132 L 41.8,140 M 48,132.6 L 47.9,140.6 M 54,133 L 54,141 M 60,133.2 L 60,141.2 M 66,133 L 66,141 M 72,132.6 L 72.1,140.6 M 78,132 L 78.2,140 M 84,131 L 84.4,139"/>
                    <Path Stroke="#4D000000" StrokeThickness="1.2" Effect="{StaticResource Crease}" Data="M 29,129 Q 60,134.5 91,129"/>
                    <Ellipse Canvas.Left="21" Canvas.Top="108" Width="16" Height="8" Fill="Black" Opacity="0.32" Effect="{StaticResource SoftShadow}"/>
                </Canvas>
                <!-- Pocket -->
                <Path Fill="#1F000000" Stroke="#4E1519" StrokeThickness="1.2" Data="M 43,110 Q 60,106 77,110 L 80,127 Q 60,130 40,127 Z"/>
                <Path Stroke="#BFA9474F" StrokeThickness="0.55" StrokeDashArray="2.55 2.2"
                      Data="M 45,112.4 Q 60,108.6 75,112.4 L 77.6,125.2 Q 60,127.8 42.4,125.2 Z"/>
                <Path Stroke="#40000000" StrokeThickness="1.2" Effect="{StaticResource Crease}" Data="M 43.5,111 Q 60,107.2 76.5,111"/>
                <!-- Drawstrings -->
                <Path Stroke="#DCD3CF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 55,80 Q 53.5,88 54,96 M 65,80 Q 66.5,88 66,96"/>
                <Ellipse Canvas.Left="53.5" Canvas.Top="78.5" Width="3" Height="3" Fill="#4A1418"/>
                <Ellipse Canvas.Left="63.5" Canvas.Top="78.5" Width="3" Height="3" Fill="#4A1418"/>
                <Rectangle Canvas.Left="52.6" Canvas.Top="94.5" Width="2.8" Height="4.5" RadiusX="1.2" RadiusY="1.2" Fill="#CFC6C0"/>
                <Rectangle Canvas.Left="64.6" Canvas.Top="94.5" Width="2.8" Height="4.5" RadiusX="1.2" RadiusY="1.2" Fill="#CFC6C0"/>

                <!-- ── Hood (turns slightly with the head) ── -->
                <Canvas x:Name="Head">
                    <Canvas.RenderTransform><TranslateTransform x:Name="HoodT"/></Canvas.RenderTransform>
                    <Path Data="{StaticResource HoodShape}">
                        <Path.Fill>
                            <RadialGradientBrush Center="0.34,0.26" GradientOrigin="0.34,0.26" RadiusX="0.95" RadiusY="0.95">
                                <GradientStop Offset="0" Color="#A9474F"/><GradientStop Offset="0.5" Color="#83292F"/><GradientStop Offset="1" Color="#561A1F"/>
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="{StaticResource HoodShape}" Fill="{DynamicResource Weave}" Opacity="0.75" IsHitTestVisible="False"/>
                    <Canvas Clip="{StaticResource HoodShape}" Effect="{StaticResource Crease}" IsHitTestVisible="False">
                        <Path Stroke="#4D000000" StrokeThickness="1.6" Data="M 34,68 Q 40,76 48,79 M 86,68 Q 80,76 72,79"/>
                        <Path Stroke="#40B4525A" StrokeThickness="1" Data="M 33,64 Q 38,72 45,76"/>
                    </Canvas>

                    <!-- Face opening and eyes, clipped by the hood so they slide out of view as he turns -->
                    <Canvas Clip="{StaticResource HoodShape}">
                        <Canvas x:Name="Face">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="FaceTurn" CenterX="60"/>
                                    <TranslateTransform x:Name="FaceT"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Path Stroke="#38000000" StrokeThickness="0.5" Data="M 60,21 L 60,27"/>
                            <Ellipse Canvas.Left="34" Canvas.Top="27" Width="52" Height="49">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Offset="0" Color="#0E0E12"/><GradientStop Offset="1" Color="#000000"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Canvas.Left="36" Canvas.Top="28" Width="48" Height="36" Stroke="#80000000" StrokeThickness="5"
                                     Effect="{StaticResource SoftShadow}"/>
                            <Ellipse Canvas.Left="34" Canvas.Top="27" Width="52" Height="49" StrokeThickness="3">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#521519"/><GradientStop Offset="1" Color="#9C3C44"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse Canvas.Left="32.4" Canvas.Top="25.4" Width="55.2" Height="52.2" Stroke="#38000000" StrokeThickness="0.8"
                                     Effect="{StaticResource Crease}"/>
                        </Canvas>

                        <Canvas x:Name="Eyes">
                            <Canvas.Effect>
                                <DropShadowEffect Color="White" BlurRadius="7" ShadowDepth="0" Opacity="0.85"/>
                            </Canvas.Effect>
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="Blink" CenterY="51.5"/>
                                    <ScaleTransform x:Name="EyesTurn" CenterX="60"/>
                                    <TranslateTransform x:Name="Look"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="47" Canvas.Top="45" Width="9" Height="13" Fill="White"/>
                            <Ellipse Canvas.Left="64" Canvas.Top="45" Width="9" Height="13" Fill="White"/>
                        </Canvas>
                    </Canvas>

                    <!-- Seasonal outfits (VexOutfits.cs): at most one shown, picked by name from Occasions.All (or the
                         birthday party hat, Occasions.Birthday). Inside the
                         hood so they ride along with every breath, sit, nap, climb and turn. Each keeps clear of the eyes
                         (y 45-58). Named in NotHoodie, so their reds aren't repainted with the hoodie colour. -->
                    <Canvas x:Name="Outfit">
                        <Canvas.RenderTransform><TranslateTransform x:Name="OutfitT"/></Canvas.RenderTransform>

                        <!-- Christmas: a floppy Santa hat on the crown, tip and bobble falling to one side -->
                        <Canvas x:Name="SantaHat" Visibility="Collapsed">
                            <Path Data="M 36,30 C 36,12 48,0 64,-1 C 80,-2 92,8 99,20 L 95,23 C 89,14 82,10 76,11 C 81,16 84,23 84,30 Z">
                                <Path.Fill>
                                    <RadialGradientBrush Center="0.36,0.3" GradientOrigin="0.36,0.3" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Offset="0" Color="#D8383C"/><GradientStop Offset="0.55" Color="#B0242A"/><GradientStop Offset="1" Color="#6E1216"/>
                                    </RadialGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M 36,30 C 36,12 48,0 64,-1 C 80,-2 92,8 99,20 L 95,23 C 89,14 82,10 76,11 C 81,16 84,23 84,30 Z"
                                  Fill="{DynamicResource Weave}" Opacity="0.75"/>
                            <Path Stroke="#59000000" StrokeThickness="1.4" Effect="{StaticResource Crease}" Data="M 75,12 C 80,15 83,21 84,28"/>
                            <!-- Fur brim, following the curve of the hood just above the face opening -->
                            <Path Fill="{StaticResource Glove}" Data="M 33,36 Q 33,30 37,29 Q 60,17 83,29 Q 87,30 87,36 Q 60,24 33,36 Z"/>
                            <Path Fill="{DynamicResource Weave}" Opacity="0.45" Data="M 33,36 Q 33,30 37,29 Q 60,17 83,29 Q 87,30 87,36 Q 60,24 33,36 Z"/>
                            <Ellipse Canvas.Left="92.5" Canvas.Top="16.5" Width="11" Height="11" Fill="{StaticResource Glove}"/>
                            <Ellipse Canvas.Left="92.5" Canvas.Top="16.5" Width="11" Height="11" Fill="{DynamicResource Weave}" Opacity="0.45"/>
                        </Canvas>

                        <!-- Easter: bunny ears on a headband, one up, one bent over -->
                        <Canvas x:Name="BunnyEars" Visibility="Collapsed">
                            <Path Fill="{StaticResource Glove}" Data="M 44,27 C 36,10 34,-10 41,-16 C 48,-20 54,0 53,25 Z"/>
                            <Path Fill="#E3A3AE" Data="M 46,22 C 41,10 40,-6 43,-11 C 47,-13 50,2 50,21 Z"/>
                            <Path Fill="{StaticResource Glove}" Data="M 67,25 C 67,10 70,0 76,-4 C 82,-8 94,-6 97,0 C 92,0 84,2 80,8 C 78,14 77,20 77,25 Z"/>
                            <Path Fill="#E3A3AE" Data="M 70,22 C 70,10 72,3 77,0 C 82,-3 89,-3 92,-1 C 87,0 81,3 78,8 C 76,13 75,18 75,22 Z"/>
                            <Path Stroke="#40000000" StrokeThickness="1" Effect="{StaticResource Crease}" Data="M 79,9 C 82,4 88,1 94,-1"/>
                            <Path Stroke="#D6CFC8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 36,32 Q 60,15 84,32"/>
                        </Canvas>

                        <!-- Halloween: a red hannya-style oni mask pushed up onto the side of the hood, festival style, so
                             both eyes stay in view; a cord runs over the top of the hood to hold it -->
                        <Canvas x:Name="OniMask" Visibility="Collapsed">
                            <Path Stroke="#3A1416" StrokeThickness="0.9" Data="M 42,27 Q 62,17 83,31"/>
                            <Canvas>
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-20"/>
                                        <TranslateTransform X="34" Y="34"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Fill="#EDE3C8" Stroke="#A89E86" StrokeThickness="0.4" Data="M -7,-10 C -9.5,-15 -9.5,-19 -7.5,-23 C -5.5,-18.5 -4,-14.5 -3,-12 Z"/>
                                <Path Fill="#EDE3C8" Stroke="#A89E86" StrokeThickness="0.4" Data="M 7,-10 C 9.5,-15 9.5,-19 7.5,-23 C 5.5,-18.5 4,-14.5 3,-12 Z"/>
                                <Path Stroke="#4A0E10" StrokeThickness="0.7"
                                      Data="M -10,-6 C -10,-12 -5,-13 0,-13 C 5,-13 10,-12 10,-6 C 10,4 7,12 0,13 C -7,12 -10,4 -10,-6 Z">
                                    <Path.Fill>
                                        <RadialGradientBrush Center="0.38,0.3" GradientOrigin="0.38,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#E0453A"/><GradientStop Offset="0.6" Color="#B02A22"/><GradientStop Offset="1" Color="#6A1410"/>
                                        </RadialGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <!-- Lacquer shine -->
                                <Ellipse Canvas.Left="-7.5" Canvas.Top="-11.5" Width="6" Height="3.6" Fill="White" Opacity="0.28"/>
                                <Path Stroke="#1A0B0B" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M -8,-6.5 L -2,-3.6 M 8,-6.5 L 2,-3.6"/>
                                <Ellipse Canvas.Left="-6.6" Canvas.Top="-3.4" Width="4" Height="2.8" Fill="#E8B33C"/>
                                <Ellipse Canvas.Left="2.6" Canvas.Top="-3.4" Width="4" Height="2.8" Fill="#E8B33C"/>
                                <Ellipse Canvas.Left="-5.2" Canvas.Top="-2.7" Width="1.4" Height="1.4" Fill="#1A0B0B"/>
                                <Ellipse Canvas.Left="3.8" Canvas.Top="-2.7" Width="1.4" Height="1.4" Fill="#1A0B0B"/>
                                <Path Stroke="#5A1210" StrokeThickness="0.7" Data="M -1.6,2.2 Q 0,3.6 1.6,2.2"/>
                                <Path Fill="#2A0A0A" Data="M -6.5,6 Q 0,4.2 6.5,6 Q 4.5,11.2 0,11.2 Q -4.5,11.2 -6.5,6 Z"/>
                                <Path Fill="#F4EEE0" Data="M -5.6,6.1 L -4.4,9.4 L -3.2,5.6 Z M 5.6,6.1 L 4.4,9.4 L 3.2,5.6 Z"/>
                            </Canvas>
                        </Canvas>

                        <!-- Your birthday (VexBirthday.cs; Occasions.Birthday): a matte paper party hat on the crown, leaning a
                             touch, gold stripes wound round it, a fluffy trim and pompom, and the elastic down the side of the
                             hood. The brim just overlaps the top of the face opening (down to y 32), like the Santa hat's,
                             well clear of the eyes. -->
                        <Canvas x:Name="PartyHat" Visibility="Collapsed">
                            <Path Data="M 46,26 Q 51,7 57,-12 Q 66,7 74,26 Q 60,31 46,26 Z">
                                <Path.Fill>
                                    <RadialGradientBrush Center="0.34,0.4" GradientOrigin="0.34,0.4" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Offset="0" Color="#7E64C4"/><GradientStop Offset="0.55" Color="#5B439E"/><GradientStop Offset="1" Color="#33245E"/>
                                    </RadialGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- Stripes, clipped to the cone -->
                            <Canvas Clip="M 46,26 Q 51,7 57,-12 Q 66,7 74,26 Q 60,31 46,26 Z">
                                <Path Stroke="#E8B33C" StrokeThickness="3"
                                      Data="M 40,27 Q 58,22 78,14 M 42,15 Q 58,10 76,2 M 46,3 Q 57,-1 72,-8"/>
                                <Path Stroke="#9C7520" StrokeThickness="0.5" Opacity="0.6"
                                      Data="M 40,28.6 Q 58,23.6 78,15.6 M 42,16.6 Q 58,11.6 76,3.6 M 46,4.6 Q 57,0.6 72,-6.4"/>
                            </Canvas>
                            <Path Data="M 46,26 Q 51,7 57,-12 Q 66,7 74,26 Q 60,31 46,26 Z" Fill="{DynamicResource Weave}" Opacity="0.75"/>
                            <!-- Shade down the far side, a little light on the near one -->
                            <Path Stroke="#59000000" StrokeThickness="1.6" Effect="{StaticResource Crease}" Data="M 62,-4 Q 67,9 72,24"/>
                            <Path Stroke="#33FFFFFF" StrokeThickness="1" Data="M 50,20 Q 53,7 56,-6"/>
                            <!-- Elastic, running down the side of the hood to under the chin -->
                            <Path Stroke="#BFD6CFC8" StrokeThickness="0.8" Data="M 73.5,27 Q 84,40 86,58"/>
                            <!-- Fluffy trim round the brim, and the pompom -->
                            <Path Fill="{StaticResource Glove}" Data="M 44.5,25.5 Q 60,31 75.5,25.5 Q 76.5,28 75,29 Q 60,34 45,29 Q 43.5,28 44.5,25.5 Z"/>
                            <Path Fill="{DynamicResource Weave}" Opacity="0.45" Data="M 44.5,25.5 Q 60,31 75.5,25.5 Q 76.5,28 75,29 Q 60,34 45,29 Q 43.5,28 44.5,25.5 Z"/>
                            <Ellipse Canvas.Left="52.5" Canvas.Top="-17" Width="9" Height="9" Fill="{StaticResource Glove}"/>
                            <Ellipse Canvas.Left="52.5" Canvas.Top="-17" Width="9" Height="9" Fill="{DynamicResource Weave}" Opacity="0.45"/>
                        </Canvas>
                    </Canvas>
                </Canvas>

                <!-- Laptop on his lap while he codes (VexCoding.cs). We see the back of the lid; the screen faces him
                     and lights his chin and front. Under the mittens so they rest on it while he types. -->
                <Canvas x:Name="Laptop" Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="LaptopGlow" Canvas.Left="37" Canvas.Top="64" Width="46" Height="44" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.85" GradientOrigin="0.5,0.85" RadiusX="0.55" RadiusY="0.6">
                                <GradientStop Offset="0" Color="#70B8DCFF"/><GradientStop Offset="1" Color="#00B8DCFF"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Path Fill="#5E6372" Stroke="#2A2D36" StrokeThickness="0.7" Data="M 39,124 L 81,124 L 83.5,127.6 L 36.5,127.6 Z"/>
                    <Path Stroke="#8A90A2" StrokeThickness="0.5" Data="M 38,126.9 L 82,126.9"/>
                    <Canvas>
                        <Canvas.RenderTransform><ScaleTransform x:Name="LidS" CenterY="124"/></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="42" Canvas.Top="104" Width="36" Height="20.4" RadiusX="2" RadiusY="2"
                                   Stroke="#2A2D36" StrokeThickness="0.7">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#6A7080"/><GradientStop Offset="1" Color="#3C404C"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Light from the screen catching the lid's top edge -->
                        <Path Stroke="#B0BFE3FF" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 43.6,104.4 L 76.4,104.4"/>
                        <Ellipse Canvas.Left="58.2" Canvas.Top="112.4" Width="3.6" Height="3.6" Fill="#8A90A2"/>
                    </Canvas>
                </Canvas>

                <!-- ── Front: mittens, mug, (boots are below, outside the breathing group) ── -->
                <Canvas>
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LeftGloveS" CenterX="29" CenterY="106.5"/>
                            <TranslateTransform x:Name="LeftGloveT"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <!-- Props the free mitten holds during idle activities (see VexActs.cs) -->
                    <Canvas x:Name="Book" Opacity="0" IsHitTestVisible="False">
                        <Path Fill="#2F4A6B" Data="M 21,92 L 36,94.5 L 51,92 L 51,105.5 L 36,108 L 21,105.5 Z"/>
                        <Path Fill="#EFE8D8" Data="M 22.6,92.9 L 36,95.2 L 36,106.4 L 22.6,104.1 Z"/>
                        <Path Fill="#E4DCCA" Data="M 49.4,92.9 L 36,95.2 L 36,106.4 L 49.4,104.1 Z"/>
                        <Path Stroke="#A89E8A" StrokeThickness="0.5"
                              Data="M 24.5,96 L 34,97.6 M 24.5,98.4 L 34,100 M 24.5,100.8 L 31,101.9 M 38,97.6 L 47.5,96 M 38,100 L 47.5,98.4 M 38,102.4 L 45,101.2"/>
                        <Path x:Name="FlipPage" Fill="#F4EEE0" Stroke="#CFC6B2" StrokeThickness="0.3" Opacity="0"
                              Data="M 49.4,92.9 L 36,95.2 L 36,106.4 L 49.4,104.1 Z">
                            <Path.RenderTransform><ScaleTransform x:Name="FlipT" CenterX="36"/></Path.RenderTransform>
                        </Path>
                    </Canvas>
                    <Canvas x:Name="Sandwich" Opacity="0" IsHitTestVisible="False">
                        <Canvas.RenderTransform><ScaleTransform x:Name="SandwichS" CenterX="30" CenterY="97"/></Canvas.RenderTransform>
                        <Path Fill="#F3DDA8" Stroke="#C99A55" StrokeThickness="0.9" Data="M 22,99 L 38,99 L 30,86 Z"/>
                        <Path Stroke="#D9534F" StrokeThickness="1" Data="M 25.5,94 L 34.5,94"/>
                        <Path Stroke="#6DB34F" StrokeThickness="1.3" Data="M 24.5,96.4 L 35.5,96.4"/>
                    </Canvas>
                    <Canvas x:Name="Phone" Opacity="0" IsHitTestVisible="False">
                        <Rectangle Canvas.Left="23.5" Canvas.Top="84" Width="11" Height="17.5" RadiusX="1.8" RadiusY="1.8"
                                   Fill="#1E2230" Stroke="#4A5068" StrokeThickness="0.7"/>
                        <Rectangle x:Name="PhoneScreen" Canvas.Left="24.8" Canvas.Top="85.4" Width="8.4" Height="13.6" RadiusX="0.8" RadiusY="0.8"
                                   Fill="#86B9EA"/>
                        <Path Stroke="#5A8CC0" StrokeThickness="0.6" Data="M 26,88 L 32,88 M 26,90.5 L 31,90.5 M 26,93 L 32,93 M 26,95.5 L 30,95.5"/>
                    </Canvas>
                    <Ellipse Canvas.Left="21" Canvas.Top="99" Width="16" Height="15" Fill="{StaticResource Glove}"/>
                    <Ellipse Canvas.Left="21" Canvas.Top="99" Width="16" Height="15" Fill="{DynamicResource Weave}" Opacity="0.35" IsHitTestVisible="False"/>
                </Canvas>

                <!-- Ripple on the "glass" when he knocks (VexKnock.cs) -->
                <Ellipse x:Name="Ripple" Width="20" Height="20" Stroke="White" StrokeThickness="1.2" Opacity="0" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="RippleS" CenterX="10" CenterY="10"/></Ellipse.RenderTransform>
                </Ellipse>

                <!-- Mug, held in the right mitten. A see-through gauge so the level reads at a glance. -->
                <Canvas x:Name="Mug" Canvas.Left="80" Canvas.Top="83" Width="28" Height="24" Background="Transparent">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="MugR" CenterX="8" CenterY="14"/>
                            <TranslateTransform x:Name="MugT"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas x:Name="Steam" Opacity="0">
                        <Canvas.RenderTransform><TranslateTransform x:Name="SteamT"/></Canvas.RenderTransform>
                        <Path Stroke="#99FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4.5,3 C 1.5,-1 7.5,-4 4.5,-9 M 11,3 C 8,-1 14,-4 11,-9"/>
                    </Canvas>
                    <Ellipse Canvas.Left="12.5" Canvas.Top="7.5" Width="9" Height="11" Stroke="#D8D1C3" StrokeThickness="2.6"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="4" Width="15.5" Height="19" RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#F6F3EC"/><GradientStop Offset="0.6" Color="#E4DED2"/><GradientStop Offset="1" Color="#B3AB9B"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Canvas.Left="2.25" Canvas.Top="6.25" Width="11" Height="14.5" RadiusX="1.5" RadiusY="1.5" Fill="#A49C8E"/>
                    <Rectangle x:Name="Coffee" Canvas.Left="2.25" Canvas.Top="6.25" Width="11" Height="14.5" RadiusX="1.5" RadiusY="1.5" Fill="#5B3521"/>
                </Canvas>
                <Canvas>
                    <Canvas.RenderTransform><TranslateTransform x:Name="RightGloveT"/></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="91" Canvas.Top="95" Width="16" Height="15" Fill="{StaticResource Glove}"/>
                    <Ellipse Canvas.Left="91" Canvas.Top="95" Width="16" Height="15" Fill="{DynamicResource Weave}" Opacity="0.35" IsHitTestVisible="False"/>
                </Canvas>
            </Canvas>

            <!-- Lunch box, on the floor beside him at lunchtime (VexLunch.cs) -->
            <Canvas x:Name="LunchBox" Opacity="0" IsHitTestVisible="False">
                <Rectangle Canvas.Left="-6" Canvas.Top="139" Width="22" Height="10" RadiusX="2" RadiusY="2" Fill="#3B7DD8" Stroke="#2A5FA8" StrokeThickness="0.8"/>
                <Rectangle Canvas.Left="-4.5" Canvas.Top="139.6" Width="19" Height="2.6" Fill="#24467A"/>
                <Canvas>
                    <Canvas.RenderTransform><RotateTransform x:Name="LidR" CenterX="-6" CenterY="139"/></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="-7" Canvas.Top="136.4" Width="24" Height="3.2" RadiusX="1.5" RadiusY="1.5" Fill="#4A8CE6" Stroke="#2A5FA8" StrokeThickness="0.6"/>
                    <Path Stroke="#2A5FA8" StrokeThickness="1" Data="M 2,136.4 Q 5,133.2 8,136.4"/>
                </Canvas>
            </Canvas>

            <!-- Boots -->
            <Canvas x:Name="LeftFoot">
                <Canvas.RenderTransform><TranslateTransform x:Name="LeftFootT"/></Canvas.RenderTransform>
                <Path Fill="{StaticResource Boot}"
                      Data="M 36,148.5 C 34,148.5 33.5,144 36,141 C 38.5,138 46,137 52,139 C 57,140.5 58,148.5 54,148.5 Z"/>
                <Path Stroke="#CC9C8676" StrokeThickness="0.9" Data="M 35,147.6 L 55,147.6"/>
            </Canvas>
            <Canvas x:Name="RightFoot">
                <Canvas.RenderTransform><TranslateTransform x:Name="RightFootT"/></Canvas.RenderTransform>
                <Path Fill="{StaticResource Boot}"
                      Data="M 64,148.5 C 61,148.5 62,140.5 67,139 C 73,137 81.5,138 84,141 C 86.5,144 86,148.5 84,148.5 Z"/>
                <Path Stroke="#CC9C8676" StrokeThickness="0.9" Data="M 65,147.6 L 85,147.6"/>
            </Canvas>

            <!-- Juggling balls (VexJuggle.cs). Outside the breathing group so a dropped one stays on the floor; each is
                 centred on its own origin and moved by its transform. In front of everything, face included. -->
            <Canvas x:Name="Balls" Opacity="0" IsHitTestVisible="False">
                <Ellipse Canvas.Left="-3.5" Canvas.Top="-3.5" Width="7" Height="7" Fill="#E8B33C" Stroke="#9C7520" StrokeThickness="0.6">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="Ball0"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="-3.5" Canvas.Top="-3.5" Width="7" Height="7" Fill="#3FA7A0" Stroke="#24706B" StrokeThickness="0.6">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="Ball1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="-3.5" Canvas.Top="-3.5" Width="7" Height="7" Fill="#5B7FD6" Stroke="#3A579E" StrokeThickness="0.6">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="Ball2"/></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Canvas>
    </Canvas>
</Window>
