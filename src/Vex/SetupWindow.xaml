<Window x:Class="Vex.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vex setup" Width="600" Height="440" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#151826" FontFamily="Segoe UI" FontSize="12" Foreground="#E8EAF2">
    <!-- Sections are tabs down the left so the window stays a fixed, modest size however many settings there are. -->
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3BF"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232842"/><Setter Property="Foreground" Value="#E8EAF2"/>
            <Setter Property="BorderBrush" Value="#3A4568"/><Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#E8EAF2"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EAF2"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E8EAF2"/><Setter Property="Margin" Value="0,5,0,0"/></Style>

        <!-- Left-hand tab list: plain text rows, the selected one highlighted with an accent bar. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AA3BF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Row" Background="Transparent" Padding="12,7" Margin="0,1" CornerRadius="5" Cursor="Hand">
                            <DockPanel>
                                <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" Margin="-8,0,7,0" CornerRadius="1.5" Background="Transparent"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1E2338"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#232842"/>
                                <Setter TargetName="Bar" Property="Background" Value="#B0413E"/>
                                <Setter Property="Foreground" Value="#E8EAF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="140" Background="#11131F" Padding="8,10">
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,10">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom bar, always visible whichever tab is open. -->
        <Border DockPanel.Dock="Bottom" Background="#11131F" BorderBrush="#232842" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button x:Name="Done" DockPanel.Dock="Right" Content="Off we go" Padding="16,4" IsDefault="True"/>
                <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0"
                           Text="Change any of this later: right-click me or my tray icon → Setup…"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
            <TabItem Header="You">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Hello. I'm Vex."/>
                    <TextBlock x:Name="IntroNote" Style="{StaticResource Note}"
                               Text="I live on your taskbar, keep out of the way, nudge you about breaks and meetings, and chat when you click me."/>
                    <TextBlock Style="{StaticResource Heading}" Text="What should I call you?"/>
                    <TextBox x:Name="NameBox"/>
                    <StackPanel x:Name="WorkPart">
                        <TextBlock Style="{StaticResource Heading}" Text="Where do you work? (optional)"/>
                        <TextBox x:Name="WorkBox"/>
                        <TextBlock Style="{StaticResource Note}" Text="Just gives me a little context when we chat."/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="NotesTab" Header="Notes">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Where should I keep your to-dos and notes?"/>
                    <RadioButton x:Name="UseNotebook" GroupName="Notes" Content="Lab Notebook"/>
                    <TextBlock x:Name="NotebookNote" Style="{StaticResource Note}" Margin="20,0,0,0"/>
                    <RadioButton x:Name="UseLocal" GroupName="Notes" Content="A folder of notes on this PC (plain markdown files)"/>
                    <DockPanel Margin="20,6,0,0">
                        <Button x:Name="Browse" DockPanel.Dock="Right" Content="Browse…" Padding="8,2" Margin="6,0,0,0"/>
                        <TextBox x:Name="FolderBox"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,12,0,0"
                               Text="My own pages (what I've learned about you and your work) stay in my memory folder either way: Privacy → Memory."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Behaviour">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Behaviour"/>
                    <CheckBox x:Name="Startup" Content="Start me with Windows"/>
                    <CheckBox x:Name="Knock" Content="Knock sound when I need your attention (never during calls)"/>
                    <CheckBox x:Name="ClaudeHooks">
                        <TextBlock Text="Tell me when Claude Code needs you (adds small hooks to Claude Code's settings)" TextWrapping="Wrap" Foreground="#E8EAF2"/>
                    </CheckBox>
                    <TextBlock x:Name="ClaudeNote" Style="{StaticResource Note}" Margin="20,0,0,0"/>
                    <CheckBox x:Name="ChatClickAway" Content="Close the chat when you click outside it"/>
                    <TextBlock x:Name="ChatClickAwayNote" Style="{StaticResource Note}" Margin="20,0,0,0"
                               Text="Not while I'm replying or a Build it button is waiting. Anything half-typed is kept for next time."/>
                    <CheckBox x:Name="CodingAtLaptop" Content="Sit in a corner and type on a laptop while I'm changing my own code"/>
                    <CheckBox x:Name="CodingForClaude" Content="…and while one of your Claude Code sessions is working" Margin="20,5,0,0"
                              IsEnabled="{Binding IsChecked, ElementName=CodingAtLaptop}"/>
                    <TextBlock x:Name="CodingNote" Style="{StaticResource Note}" Margin="20,0,0,0"
                               Text="Bottom-right corner (CodingCorner in config.json). Drag me somewhere and I'll type there instead."/>
                    <CheckBox x:Name="LunchRoutine" Content="Have my own lunch when you go for yours (a sandwich, then a nap)"/>
                    <StackPanel Orientation="Horizontal" Margin="20,5,0,0" IsEnabled="{Binding IsChecked, ElementName=LunchRoutine}">
                        <TextBlock Text="Lunch length" VerticalAlignment="Center"/>
                        <TextBox x:Name="LunchMinutes" Width="45" Margin="8,0,6,0"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="LunchNote" Style="{StaticResource Note}" Margin="20,0,0,0"
                               Text="Starts when you press Going on the lunch nudge or tell me you're off. Come back early and I'll wake up."/>

                    <!-- One checkbox per idle activity, made in code from IdleActs.All so new ones show up here by themselves. -->
                    <TextBlock Style="{StaticResource Heading}" Text="Idle actions"/>
                    <TextBlock Style="{StaticResource Note}" Text="What I get up to when I'm bored. Untick them all and I'll just stand about."/>
                    <WrapPanel x:Name="IdleActsList"/>

                    <!-- What used to be on the right-click menu. Happens straight away; nothing here waits for Save. -->
                    <StackPanel x:Name="RightNow">
                        <TextBlock Style="{StaticResource Heading}" Text="Right now"/>
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button"><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="0,4,6,0"/></Style>
                            </WrapPanel.Resources>
                            <Button x:Name="LunchNow"/>
                            <Button x:Name="NapNow"/>
                            <Button x:Name="CoffeeNow" Content="I refilled my coffee"/>
                            <Button x:Name="OtherScreen" Content="Go to the other screen"/>
                            <Button x:Name="HideNow"/>
                            <Button x:Name="ChatNow" Content="Chat"/>
                            <Button x:Name="ForgetNow" Content="Forget today's chat"/>
                        </WrapPanel>
                        <TextBlock x:Name="RightNowNote" Style="{StaticResource Note}"
                                   Text="These happen straight away. Chat closes this window first (without saving)."/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WatchTab" Header="Watching">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Watching and learning"/>
                    <CheckBox x:Name="ActivityLog" Content="Keep a log of which app and window title is in front"/>
                    <TextBlock Style="{StaticResource Note}" Margin="20,0,0,0"
                               Text="Lets me answer &quot;what was I doing?&quot; and spot long stretches. Off: I only know app names, today, in memory."/>
                    <CheckBox x:Name="Curious" Content="Now and then, ask me about things you keep seeing in window titles"/>
                    <TextBlock Style="{StaticResource Note}" Margin="20,0,0,0"
                               Text="So I learn your projects, kit and people. A few questions a day at most, as ordinary nudges."/>
                    <TextBlock Style="{StaticResource Heading}" Text="Apps whose window text I may read"/>
                    <TextBox x:Name="WatchApps"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Comma-separated process names, e.g. WINWORD, EXCEL, Code. Empty: never. Private windows and password fields are never read."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Going home">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Going home (optional)"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="I leave at (HH:mm)" VerticalAlignment="Center"/>
                        <TextBox x:Name="LeaveAt" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="I go home by" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                            <RadioButton x:Name="ByDrive" GroupName="By" Content="Car" Margin="0,5,14,0"/>
                            <RadioButton x:Name="ByTransit" GroupName="By" Content="Train or bus" Margin="0,5,14,0"/>
                            <RadioButton x:Name="ByCycle" GroupName="By" Content="Bike" Margin="0,5,14,0"/>
                            <RadioButton x:Name="ByWalk" GroupName="By" Content="On foot" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Work address" VerticalAlignment="Center"/>
                        <TextBox x:Name="WorkAddress" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Text="Home address" VerticalAlignment="Center"/>
                        <TextBox x:Name="HomeAddress" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                        <TextBlock x:Name="TomTomLabel" Grid.Row="4" Text="TomTom key" VerticalAlignment="Center"/>
                        <TextBox x:Name="TomTomKey" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
                    </Grid>
                    <TextBlock x:Name="HomeNote" Style="{StaticResource Note}" Margin="0,8,0,0"
                               Text="15 minutes before you leave I'll tell you to pack up, with a Google Maps button for the way home (by train or bus it lists the next departures). Driving, a free TomTom key (developer.tomtom.com) lets me check the live traffic; that sends the two addresses to TomTom. Postcodes are fine."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Privacy">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Privacy"/>
                    <TextBlock x:Name="PrivacyText" Style="{StaticResource Note}" FontSize="11.5"/>

                    <!-- The folders and files that used to be on the tray menu: everything I keep, one click away. -->
                    <TextBlock Style="{StaticResource Heading}" Text="Your data"/>
                    <WrapPanel>
                        <WrapPanel.Resources>
                            <Style TargetType="Button"><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="0,4,6,0"/></Style>
                        </WrapPanel.Resources>
                        <Button x:Name="OpenMemory" Content="Memory (my pages)"/>
                        <Button x:Name="OpenChats" Content="Chat history"/>
                        <Button x:Name="OpenConfig" Content="Settings (config.json)"/>
                        <Button x:Name="OpenData" Content="Data folder"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
