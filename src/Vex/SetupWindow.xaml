<Window x:Class="Vex.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vex setup" Width="520" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#151826" FontFamily="Segoe UI" FontSize="13" Foreground="#E8EAF2">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3BF"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232842"/><Setter Property="Foreground" Value="#E8EAF2"/>
            <Setter Property="BorderBrush" Value="#3A4568"/><Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#E8EAF2"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EAF2"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E8EAF2"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    </Window.Resources>

    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Hello. I'm Vex." FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                   Text="I live on your taskbar, keep out of the way, nudge you about breaks and meetings, and chat when you click me. A couple of questions first. You can change all of this later from my tray icon (Setup…)."/>

        <TextBlock Style="{StaticResource Heading}" Text="What should I call you?"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Style="{StaticResource Heading}" Text="Where do you work? (optional)"/>
        <TextBox x:Name="WorkBox"/>
        <TextBlock Style="{StaticResource Note}" Text="Just gives me a little context when we chat."/>

        <TextBlock Style="{StaticResource Heading}" Text="Where should I keep your to-dos and notes?"/>
        <RadioButton x:Name="UseNotebook" GroupName="Notes" Content="Lab Notebook"/>
        <TextBlock x:Name="NotebookNote" Style="{StaticResource Note}" Margin="22,0,0,0"/>
        <RadioButton x:Name="UseLocal" GroupName="Notes" Content="A folder of notes on this PC (plain markdown files)"/>
        <DockPanel Margin="22,6,0,0">
            <Button x:Name="Browse" DockPanel.Dock="Right" Content="Browse…" Padding="10,3" Margin="6,0,0,0"/>
            <TextBox x:Name="FolderBox"/>
        </DockPanel>

        <TextBlock Style="{StaticResource Heading}" Text="Options"/>
        <CheckBox x:Name="Startup" Content="Start me with Windows"/>
        <CheckBox x:Name="Knock" Content="Knock sound when I need your attention (never during calls)"/>
        <CheckBox x:Name="ClaudeHooks">
            <TextBlock Text="Tell me when Claude Code needs you (adds small hooks to Claude Code's settings)" TextWrapping="Wrap" Foreground="#E8EAF2"/>
        </CheckBox>
        <CheckBox x:Name="ActivityLog" Content="Keep a log of which app and window title is in front"/>
        <TextBlock Style="{StaticResource Note}" Margin="22,0,0,0"
                   Text="Lets me answer &quot;what was I doing?&quot; and spot long stretches. Off: I only know app names, today, in memory."/>

        <TextBlock Style="{StaticResource Heading}" Text="Watching and learning"/>
        <CheckBox x:Name="Curious" Content="Now and then, ask me about things you keep seeing in window titles"/>
        <TextBlock Style="{StaticResource Note}" Margin="22,0,0,0"
                   Text="So I learn your projects, kit and people. A few questions a day at most, as ordinary nudges."/>
        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2" Text="Apps whose window text I may read (comma-separated process names, e.g. WINWORD, EXCEL, Code). Empty: never."/>
        <TextBox x:Name="WatchApps"/>

        <TextBlock Style="{StaticResource Heading}" Text="Going home (optional)"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="I leave at (HH:mm)" VerticalAlignment="Center"/>
            <TextBox x:Name="LeaveAt" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Work address" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkAddress" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
            <TextBlock Grid.Row="2" Text="Home address" VerticalAlignment="Center"/>
            <TextBox x:Name="HomeAddress" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
            <TextBlock Grid.Row="3" Text="TomTom key" VerticalAlignment="Center"/>
            <TextBox x:Name="TomTomKey" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
        </Grid>
        <TextBlock Style="{StaticResource Note}"
                   Text="15 minutes before you leave I'll tell you to pack up. With a free TomTom key (developer.tomtom.com) I check the live drive home; that sends the two addresses to TomTom. Without one you get a Google Maps button. Postcodes are fine."/>

        <TextBlock Style="{StaticResource Heading}" Text="Privacy"/>
        <TextBlock x:Name="PrivacyText" Style="{StaticResource Note}"/>
        <TextBlock x:Name="ClaudeNote" Style="{StaticResource Note}" Margin="0,8,0,0"/>

        <Button x:Name="Done" Content="Off we go" HorizontalAlignment="Right" Padding="18,6" Margin="0,18,0,0" IsDefault="True"/>
    </StackPanel>
</Window>
